# ===========================================
# Routiners App - Environment Variables
# ===========================================
# 이 파일을 복사하여 .env.local로 저장하세요
# cp .env.example .env.local

# ===========================================
# WebView URL (Required)
# ===========================================
# 개발 환경: 로컬 웹 서버 주소 (본인 IP로 변경 필요)
EXPO_PUBLIC_WEBVIEW_URL=http://192.168.0.xxx:3000

# 프로덕션 환경:
# EXPO_PUBLIC_WEBVIEW_URL=https://routiners-web.vercel.app

# ===========================================
# Supabase Configuration (Required)
# ===========================================
# Supabase 프로젝트 URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (공개키)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# ===========================================
# Google OAuth (Required for Google Sign-In)
# ===========================================
# Google Cloud Console에서 발급받은 Web Client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com

# ===========================================
# API Configuration (Optional)
# ===========================================
# 외부 API URL (필요시)
# EXPO_PUBLIC_API_URL=https://api.example.com
